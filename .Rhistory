fixed_vars <- c("pass.fname",
"pass.lname",
"pass.dob",
"pass.age",
"pass.gender",
"pass.status",
"home.address",
"home.city",
"home.prov",
"home.country",
"emerg.contact.fname",
"emerg.contact.lname",
"emerg.contact.relationship",
"emerg.contact.phone",
"board.date",
"board.location")
# Replace the variable names in the dataset with the corrected versions:
names(manifest) <- fixed_vars
# Print the names and double check that it worked!
names(manifest)
#Let's have a look at the data in the dob variable:
glimpse(manifest %>% select(pass.dob))
# Let's start by printing the entire DOB variable and checking which entries need fixing:
birthdates <- manifest$pass.dob
print(birthdates)
# library(lubridate)
birthdates[14] <- ymd("1992-08-21") - ymd("1899-12-30")
birthdates[97] <- ymd("1982-08-30") - ymd("1899-12-30")
birthdates[127] <- ymd("1993-03-09") - ymd("1899-12-30")
birthdates[155] <- ymd("1959-01-13") - ymd("1899-12-30")
birthdates[568] <- ymd("1968-07-18") - ymd("1899-12-30")
print(birthdates) # check to make sure everything looks OK
# Use as_date() from lubridate, and set the Excel origin
# We'll need to change our birthdates back to numeric first, as well.
birthdates <- as_date(as.numeric(birthdates), origin= "1899-12-30")
manifest$pass.dob <- birthdates
# Doublecheck to make sure that the DOB column now looks good:
glimpse(manifest)
manifest <-
manifest %>%
mutate(
pass.age = floor(
time_length(
interval(pass.dob, ymd("2025-02-10")),
"years")
)
)
manifest %>%
select("home.prov") %>%
distinct()
manifest <-
manifest %>%
mutate(home.prov.abb = case_when(
home.prov == 'BC' ~ 'BC',
home.prov == 'British Columbia' ~ 'BC',
home.prov == 'AB' ~ 'AB',
home.prov == 'Alberta' ~ 'AB',
home.prov == 'SK' ~ 'SK',
home.prov == 'Sask' ~ 'SK',
home.prov == 'Saskatchewan' ~ 'SK',
home.prov == 'MB' ~ 'MB',
home.prov == 'Manitoba' ~ 'MB',
home.prov == 'ON' ~ 'ON',
home.prov == 'Ontario' ~ 'ON',
home.prov == 'QC' ~ 'QC',
home.prov == 'Quebec' ~ 'QC',
home.prov == 'Québec' ~ 'QC',
home.prov == 'NS' ~ 'NS',
home.prov == 'Nova Scotia' ~ 'NS',
home.prov == 'PEI' ~ 'PEI',
home.prov == 'Prince Edward Island' ~ 'PEI',
home.prov == 'New Brunswick' ~ 'NB',
home.prov == 'NFLD' ~ 'NL',
home.prov == 'Newfoundland and Labrador' ~ 'NL',
TRUE ~ "missing"
))
manifest %>%
filter(home.prov.abb == 'missing')
manifest <-
manifest %>%
mutate(home.prov = home.prov.abb) %>%
select(-home.prov.abb)
manifest <-
manifest %>%
mutate(emerg.contact.fname =
str_replace_all(
string = emerg.contact.fname,
pattern = "(Mr\\.|Mrs\\.|Dr\\.)",
replacement = "")
) %>%
mutate(emerg.contact.lname =
str_replace_all(
string = emerg.contact.lname,
pattern = "(DDS|Jr\\.)",
replacement = "")
)
manifest <-
manifest %>%
mutate(emerg.contact.fname =
case_when(emerg.contact.lname == "DavidSmith" ~ "David",
emerg.contact.lname == "GeorgeBooker" ~ "George",
emerg.contact.lname == "DouglasEvans" ~ "Douglas",
emerg.contact.lname == "JacobScott" ~ "Jacob",
emerg.contact.lname == "ToniAvila" ~ "Toni",
TRUE ~ emerg.contact.fname
),
emerg.contact.lname =
case_when(emerg.contact.lname == "DavidSmith" ~ "Smith",
emerg.contact.lname == "GeorgeBooker" ~ "Booker",
emerg.contact.lname == "DouglasEvans" ~ "Evans",
emerg.contact.lname == "JacobScott" ~ "Scott",
emerg.contact.lname == "ToniAvila" ~ "Avila",
TRUE ~ emerg.contact.lname)) %>% view()
manifest %>%
mutate(board.date = case_when(
board.date == "Feb 9th" ~ ymd('2025-02-09')
board.date == "Feb 10th" ~ ymd('2025-02-10')
manifest %>%
mutate(board.date = case_when(
board.date == "Feb 9th" ~ ymd('2025-02-09'),
board.date == "Feb 10th" ~ ymd('2025-02-10'),
TRUE == 'missing'
))
manifest %>%
mutate(board.date = case_when(
board.date == "Feb 9th" ~ ymd('2025-02-09'),
board.date == "Feb 10th" ~ ymd('2025-02-10'),
TRUE ~ 'missing')
)
manifest %>%
mutate(board.date.dt = case_when(
board.date == "Feb 9th" ~ ymd('2025-02-09'),
board.date == "Feb 10th" ~ ymd('2025-02-10'),
TRUE ~ 'missing')
)
manifest %>%
mutate(board.date.dt = case_when(
board.date == "Feb 9th" ~ ymd('2025-02-09'),
board.date == "Feb 10th" ~ ymd('2025-02-10'),
TRUE ~ NA)
)
manifest <-
manifest %>%
mutate(board.date = case_when(
board.date == "Feb 9th" ~ ymd('2025-02-09'),
board.date == "Feb 10th" ~ ymd('2025-02-10'),
TRUE ~ NA)
)
wiggle(999)
wiggle(999)
wiggle(999)
wiggle(99)
wiggle <-
function(n){
require(KeyboardSimulator)
n<-n
for(i in 1:n){
KeyboardSimulator::mouse.click("left", hold = FALSE)
print("click")
Sys.sleep(sample(1:18, 1))
}
}
library(tidyverse)
wiggle(999)
library(knitr)
options(
pillar.width = 80,
pillar.subtle = FALSE,
pillar.min_chars = 3
)
opts_chunk$set(
collapse = TRUE,
echo = TRUE,
warning = FALSE,
message = FALSE,
width = 80
)
options(width = 80)
library(pacman)
library(tidyverse)
# Load required libraries
# library(pacman)
# p_load(tidyverse)
# create a vector to store consistent and simple variable names for abdo datasets
abdo_names <- c("pass.ID", "pass.temp", "pass.height", "pass.weight", "CEDIS")
# load abdo datasets using read_csv from the readr tidyverse package:
abdo_feb10 <- read_tsv("participant_data/module3/abdo_Feb10.txt", col_names = abdo_names, skip = 4)
abdo_feb11 <- read_tsv("participant_data/module3/abdo_Feb11.txt", col_names = abdo_names, skip = 4)
abdo_feb12 <- read_tsv("participant_data/module3/abdo_Feb12.txt", col_names = abdo_names, skip = 4)
abdo_feb13 <- read_tsv("participant_data/module3/abdo_Feb13.txt", col_names = abdo_names, skip = 4)
abdo_feb14 <- read_tsv("participant_data/module3/abdo_Feb14.txt", col_names = abdo_names, skip = 4)
abdo_combined <- bind_rows(abdo_feb10,
abdo_feb11,
abdo_feb12,
abdo_feb13,
abdo_feb14,
.id = "id")
abdo_combined_onset <-
abdo_combined %>%
mutate(onset.date = case_when(
id == "1" ~ ymd('2025-02-10'),
id == "2" ~ ymd('2025-02-11'),
id == "3" ~ ymd('2025-02-12'),
id == "4" ~ ymd('2025-02-13'),
id == "5" ~ ymd('2025-02-14')
))
abdo_combined_onset <-
abdo_combined_onset %>% select(-id)
rm(abdo_combined, abdo_feb10, abdo_feb11, abdo_feb12, abdo_feb13, abdo_feb14, abdo_names)
# Import the dataset using readxl
# Note the readxl::read_excel allows for you to access functions from installed
# packages without loading the entire package.
pass_manifest <- readxl::read_excel("participant_data/module3/pass_manifest.xlsx",
skip = 10)
pass_manifest_trunc <- #truncated, temporary object
pass_manifest %>%
# Note that we wrap variables with spaces in a back-tick
select(Pass_ID, Age, Gender, `Member Status`, `Boarding Date`)
# Time to join these datasets together!
abdo_manifest <- left_join(abdo_combined_onset, pass_manifest_trunc, by = c("pass.ID" = "Pass_ID"))
CEDIS_subset <- abdo_manifest %>%
select(pass.ID, CEDIS)
CEDIS_subset_long <-
CEDIS_subset %>%
separate_rows(CEDIS, sep = ';', convert = FALSE)
#view(CEDIS_subset_long)
CEDIS_subset_wide <-
CEDIS_subset_long %>%
mutate(value = 1) %>%
pivot_wider(id_cols = pass.ID,
names_from = CEDIS,
values_from = value,
values_fill = 0)
symptoms_table <-
CEDIS_subset_wide %>%
rename("abdo.pain" = "251",
"vomiting" = "257",
"diarrhea" = "254",
"bloody.stool" = "260",
"headache" = "404")
symptoms_manifest <- full_join(symptoms_table, abdo_manifest)
# Remove all but the specified objects from memory
#rm(rm(list = setdiff(ls(), c("symptoms_manifest"))))
symptoms_manifest %>%
summarize(.by = Gender,
mean_age   = mean(Age, na.rm = TRUE),
median_age = median(Age, na.rm = TRUE),
max_age    = min(Age, na.rm = TRUE),
min_age    = max(Age, na.rm = TRUE)
)
symptoms_manifest %>%
group_by(Gender) %>%
summarize(Total = n(),
Proportion = n()/sum(Total))
symptoms_manifest %>%
group_by(Gender) %>%
summarize(Total = n(), .groups = "drop") %>%
mutate(Proportion = Total / sum(Total))
symptoms_manifest <-
symptoms_manifest %>%
mutate(Fever = case_when(
pass.temp > 38.0 ~ 1,
pass.temp <= 38.0 ~ 0,
TRUE ~ NA
))
symptoms_manifest %>%
count(Fever)
symptoms_manifest <-
symptoms_manifest %>%
mutate(
age.group = case_when(
Age < 12 ~ "0–11",
Age < 18 ~ "12–17",
Age < 30 ~ "18–29",
Age < 50 ~ "30–49",
Age < 65 ~ "50–64",
Age >= 65 ~ "65+",
TRUE ~ NA
)
)
symptoms_manifest %>%
group_by(age.group) %>%
count(Fever)
symptoms_manifest %>%
group_by(Gender) %>%
summarize(
Vomit = sum(vomiting),
Diarrhea = sum(diarrhea),
Headache = sum(headache),
Bloody.Stool = sum(bloody.stool)
)
symptoms_manifest %>%
group_by(age.group) %>%
summarize(
Vomit = sum(vomiting),
Diarrhea = sum(diarrhea),
Headache = sum(headache),
Bloody.Stool = sum(bloody.stool)
)
symptoms_manifest %>%
group_by(onset.date) %>%
count()
symptoms_manifest %>%
group_by(onset.date) %>%
count() %>%
ggplot(aes(x = onset.date, y = n)) +
geom_col()
wiggle(999)
View(symptoms_manifest)
View(symptoms_manifest)
wiggle(999)
View(symptoms_manifest)
symptoms_manifest %>%
group_by(`Member Status`) %>%
summarize(
across(
c(bloody.stool, Fever),
~ sum(.x, na.rm = TRUE)
)
)
symptoms_manifest %>%
group_by(`Boarding Date`) %>%
summarize(
across(
c(bloody.stool, Fever),
~ sum(.x, na.rm = TRUE)
)
)
wiggle(999)
wiggle(999)
wiggle(999)
wiggle(999)
