library(tidyverse)






calculate_player_xp <- function(xp_base, beta, mob_lvl, player_lvls) {
  
  n <- length(player_lvls)
  G <- sum(player_lvls)
  max_lvl <- max(player_lvls)
  
  # calculate raw xp per player
  xp <- xp_base *
    (1 + beta * (n - 1)) *
    (1 + ((mob_lvl - player_lvls) / 20)) *
    (player_lvls / G)
  
  # rule 2 FIRST: zero XP for under-leveled players only
  xp[player_lvls < (2/3) * max_lvl] <- 0
  
  # rule 1 SECOND: clamp remaining XP at zero
  xp <- pmax(xp, 0)
  
  xp.df <- data.frame(
    p.lvl = player_lvls,
    p.xp  = round(xp, 0)
  )
  
  xp.df$base.split <- round(xp_base / n, 0)
  xp.df$bonus.perc <- round(xp.df$p.xp / xp.df$base.split * 100, 0)
  
  return(xp.df)
}














